<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="IceCube_AiAgent::ai_agent" title="IceCube AI Agent" translate="title" sortOrder="90">
                    <resource id="IceCube_AiAgent::chat" title="Use AI Assistant" translate="title" sortOrder="10"/>
                    <resource id="IceCube_AiAgent::usage" title="View Usage Dashboard" translate="title" sortOrder="20"/>
                    <resource id="IceCube_AiAgent::audit" title="View Audit Log" translate="title" sortOrder="30"/>
                </resource>
                <resource id="Magento_Backend::stores">
                    <resource id="Magento_Backend::stores_settings">
                        <resource id="Magento_Config::config">
                            <resource id="IceCube_AiAgent::config" title="IceCube AI Agent Settings" translate="title"/>
                        </resource>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
